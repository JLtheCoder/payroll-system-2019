{
  "name": "payroll-system",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo for the TypeScript payroll system (Express API + React client).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @payroll/server",
    "dev:client": "npm run dev -w @payroll/client",
    "build": "npm run typecheck -w @payroll/server && npm run build -w @payroll/client",
    "start": "npm run start -w @payroll/server",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @payroll/server",
    "test:e2e": "npm run test:e2e -w @payroll/e2e",
    "e2e:install": "npm run install:browsers -w @payroll/e2e",
    "e2e:serve": "npm run build -w @payroll/client && npm run db:reset:e2e -w @payroll/server && npm run start -w @payroll/server",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate -w @payroll/server",
    "db:deploy": "npm run db:deploy -w @payroll/server",
    "db:studio": "npm run db:studio -w @payroll/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
