# Copy this file to `.env` and adjust as needed.

# Port the API server listens on.
PORT=8081

# `production` disables verbose logging and expects migrations to be applied.
NODE_ENV=development

# Database connection string. SQLite by default, relative to `server/`.
# To use Postgres, also change the datasource provider in prisma/schema.prisma
# and swap the driver adapter in src/data/prisma.ts for @prisma/adapter-pg.
DATABASE_URL="file:./prisma/dev.db"
